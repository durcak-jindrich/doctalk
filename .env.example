# Postgres (matches docker-compose.yml's `db` service)
DATABASE_URL=postgresql://doctalk:doctalk@localhost:5432/doctalk

# OpenRouter (OpenAI-SDK-compatible). Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Retrieval (run locally via sentence-transformers, no API cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Workspace
MAX_DOCUMENTS=5

# Azure AAD auth — off locally, on in Azure
AUTH_ENABLED=false
