# Copy to .env and set OPENROUTER_API_KEY. Only variables with no sensible
# default live here — `app/config.py` is the authoritative list of tunables
# (retrieval, synthesis thresholds, limits, logging) with their defaults; add
# one to .env only to override it.

# Postgres (matches docker-compose.yml's `db` service)
DATABASE_URL=postgresql://doctalk:doctalk@localhost:5432/doctalk

# OpenRouter (OpenAI-SDK-compatible — OPENROUTER_BASE_URL swaps the provider).
# Get a free key at https://openrouter.ai. `:free` model slugs are rate-limited
# and get retired without notice — if a call 404s, pick a current one from
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free

# Azure AAD auth — off locally, on in Azure. AZURE_TENANT_ID/AZURE_CLIENT_ID
# are required (validated at startup) when AUTH_ENABLED=true; they identify
# the Entra ID app registration that issued the token, not a secret.
AUTH_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Azure Key Vault — leave unset locally; Bicep sets both in Azure. When
# AZURE_KEY_VAULT_URL is set, `app/config.py` loads `database-url` and
# `openrouter-api-key` from it via the user-assigned managed identity named by
# AZURE_MANAGED_IDENTITY_CLIENT_ID (distinct from AZURE_CLIENT_ID above).
AZURE_KEY_VAULT_URL=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
