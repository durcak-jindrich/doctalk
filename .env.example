# Postgres (matches docker-compose.yml's `db` service)
DATABASE_URL=postgresql://doctalk:doctalk@localhost:5432/doctalk

# OpenRouter (OpenAI-SDK-compatible). Get a free key at https://openrouter.ai
# `:free` model slugs are rate-limited and get retired without notice — if a call
# 404s, pick a current one from https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# Retrieval (run locally via sentence-transformers, no API cost).
# Vector width is read from the model itself, not configured here — changing
# EMBEDDING_MODEL to a different dimension requires re-creating the chunks table.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=5

# Synthesis & citation governance. MIN_RERANK_SCORE is the cross-encoder logit
# below which the best-retrieved chunk counts as "nothing relevant" and DocTalk
# refuses instead of answering.
MIN_RERANK_SCORE=-5.0
SYNTHESIS_MAX_ATTEMPTS=2
# Total chunks fed to a whole-workspace summary, split across the documents.
SUMMARY_MAX_CHUNKS=12

# Workspace
MAX_DOCUMENTS=5
# Per-file upload ceiling in bytes (10 MB) — parsing loads the file in memory.
MAX_UPLOAD_BYTES=10485760

# Observability. `json` emits JSON Lines (ship/query as-is); `text` is the
# readable console format for local work.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Azure AAD auth — off locally, on in Azure
AUTH_ENABLED=false
